<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Docked Mini-Player Floating Bar (Floats cleanly above the 64dp bottom navigation bar) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/mini_player_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="76dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="?android:attr/colorBackgroundFloating"
        app:cardCornerRadius="16dp"
        app:cardElevation="10dp"
        app:cardPreventCornerOverlap="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <ImageView
                android:id="@+id/mini_thumbnail"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/shape_rounded_thumbnail"
                android:clipToOutline="true"
                android:contentDescription="@string/app_name"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_pets"
                app:tint="?attr/colorAccent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/mini_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?android:attr/textAppearanceListItem"
                    android:textStyle="bold"
                    tools:text="Downloaded Video" />

                <TextView
                    android:id="@+id/mini_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/downloads"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/mini_prev"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/local_player_previous"
                android:src="@drawable/ic_previous"
                app:tint="?android:attr/colorControlNormal" />

            <ImageButton
                android:id="@+id/mini_play_pause"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/local_player_play"
                android:src="@drawable/ic_pause"
                app:tint="?attr/colorAccent" />

            <ImageButton
                android:id="@+id/mini_next"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/local_player_next"
                android:src="@drawable/ic_next"
                app:tint="?android:attr/colorControlNormal" />

            <ImageButton
                android:id="@+id/mini_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_close"
                app:tint="?android:attr/colorControlNormal" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Fullscreen Player View (Revealed when mini-player is clicked) -->
    <LinearLayout
        android:id="@+id/fullscreen_player_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/windowBackground"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top Drag Pill Handle (Tap or swipe down to minimise) -->
        <View
            android:id="@+id/drag_handle"
            android:layout_width="40dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/shape_drag_handle" />

        <!-- Top Action Bar with Prominent Collapse Button -->
        <RelativeLayout
            android:id="@+id/full_top_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/full_collapse"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_expand_more"
                app:tint="?android:attr/colorControlNormal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/local_player_now_playing"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/full_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_close"
                app:tint="?android:attr/colorControlNormal" />
        </RelativeLayout>

        <!-- Large Rounded Album Art / Video Display -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="24dp"
            android:layout_weight="1"
            app:cardBackgroundColor="?android:attr/colorBackgroundFloating"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:cardPreventCornerOverlap="true">

            <com.google.android.exoplayer2.ui.PlayerView
                android:id="@+id/full_player_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:use_controller="false" />

            <ImageView
                android:id="@+id/full_album_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:padding="56dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_pets"
                app:tint="?attr/colorAccent" />
        </androidx.cardview.widget.CardView>

        <!-- Song / Video Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:id="@+id/full_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="BearTube Downloaded Track" />

            <TextView
                android:id="@+id/full_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/downloads"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <!-- Progress Scrubber -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <SeekBar
                android:id="@+id/full_seek_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressTint="?attr/colorAccent"
                android:thumbTint="?attr/colorAccent" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/full_time_current"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="0:00"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="?android:attr/textColorSecondary" />

                <TextView
                    android:id="@+id/full_time_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="0:00"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="?android:attr/textColorSecondary" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Apple-Inspired Playback Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="16dp"
            android:paddingBottom="40dp">

            <ImageButton
                android:id="@+id/full_prev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/local_player_previous"
                android:src="@drawable/ic_previous"
                app:tint="?android:attr/colorControlNormal" />

            <View
                android:layout_width="20dp"
                android:layout_height="1dp" />

            <ImageButton
                android:id="@+id/full_rewind"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/local_player_rewind"
                android:src="@drawable/ic_replay"
                app:tint="?android:attr/colorControlNormal" />

            <View
                android:layout_width="20dp"
                android:layout_height="1dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:cardBackgroundColor="?attr/colorAccent"
                app:cardCornerRadius="32dp"
                app:cardElevation="4dp"
                app:cardPreventCornerOverlap="true">

                <ImageButton
                    android:id="@+id/full_play_pause"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="@string/local_player_play"
                    android:src="@drawable/ic_pause"
                    app:tint="@android:color/white" />
            </androidx.cardview.widget.CardView>

            <View
                android:layout_width="20dp"
                android:layout_height="1dp" />

            <ImageButton
                android:id="@+id/full_forward"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/local_player_forward"
                android:src="@drawable/ic_refresh"
                app:tint="?android:attr/colorControlNormal" />

            <View
                android:layout_width="20dp"
                android:layout_height="1dp" />

            <ImageButton
                android:id="@+id/full_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/local_player_next"
                android:src="@drawable/ic_next"
                app:tint="?android:attr/colorControlNormal" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
