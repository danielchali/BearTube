<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.navigation.NavigationView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navigation"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@drawable/shape_apple_drawer_bg"
    android:elevation="16dp"
    android:orientation="vertical"
    app:headerLayout="@layout/drawer_header"
    app:itemHorizontalPadding="16dp"
    app:itemIconPadding="14dp"
    app:itemIconTint="?attr/colorAccent"
    app:itemMaxLines="1"
    app:itemShapeCornerSize="14dp"
    app:itemShapeInsetBottom="3dp"
    app:itemShapeInsetEnd="12dp"
    app:itemShapeInsetStart="12dp"
    app:itemShapeInsetTop="3dp"
    app:itemTextColor="?android:attr/textColorPrimary" />
